# Let group jeremy read RAPL energy counters (power-monitor). Not world-readable:
# fine-grained energy is a side channel (CVE-2020-8694), so keep it to this user.
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", RUN+="/usr/bin/chgrp jeremy /sys%p/energy_uj", RUN+="/usr/bin/chmod 0440 /sys%p/energy_uj"
